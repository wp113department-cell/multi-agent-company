# ============================================================
# Gridiron Developer Department — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ------------------------------------------------------------
# DATABASE (required)
# ------------------------------------------------------------
# PostgreSQL DSN. asyncpg driver required for async SQLAlchemy.
DATABASE_URL=postgresql+asyncpg://gridiron:gridiron@localhost:5432/gridiron_dev
# audit_v1.md 4.7 #2: async engine connection pool sizing — no explicit
# sizing previously meant SQLAlchemy's async default (5 + 10 overflow = 15),
# already smaller than MAX_CONCURRENT_AGENT_RUNS's own designed ceiling (20).
DB_POOL_SIZE=20
DB_POOL_MAX_OVERFLOW=10

# ------------------------------------------------------------
# ANTHROPIC API (required)
# ------------------------------------------------------------
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ------------------------------------------------------------
# MODEL TIERS (optional — defaults shown)
# ------------------------------------------------------------
# Haiku: router/triage/PM/Architect/Decomposer (cheap, fast)
MODEL_PLANNER=claude-haiku-4-5-20251001
# Sonnet: Coder/QA/Review (best code quality)
MODEL_CODER=claude-sonnet-5
# Haiku: heartbeat/summary/embeddings
MODEL_ROUTER=claude-haiku-4-5-20251001

# ------------------------------------------------------------
# OPENAI (optional — used by agents/tools that need GPT models)
# ------------------------------------------------------------
# Can also be set via the Settings UI page (Credential Vault).
OPENAI_API_KEY=

# ------------------------------------------------------------
# GROQ (optional — alternate LLM backend, dev/cost-saving fallback only)
# ------------------------------------------------------------
# When set and USE_GROQ=true, ALL agent calls route to Groq instead of
# Anthropic. Useful when ANTHROPIC_API_KEY is unavailable. Not required
# in production — leave USE_GROQ=false to always use Anthropic.
GROQ_API_KEY=
USE_GROQ=false
GROQ_MODEL_PLANNER=qwen/qwen3-32b
GROQ_MODEL_CODER=qwen/qwen3-32b
GROQ_MODEL_ROUTER=llama-3.1-8b-instant

# ------------------------------------------------------------
# VOYAGE AI (optional — enables semantic search)
# ------------------------------------------------------------
# Get your key at https://www.voyageai.com/
# If unset, context builder falls back to keyword-only scoring.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-code-2
VOYAGE_DIMENSIONS=1536

# ------------------------------------------------------------
# REPOSITORY INTELLIGENCE
# ------------------------------------------------------------
# Absolute path to the codebase agents will read and operate on.
TARGET_REPO_PATH=/home/pc-117/Documents/CRR2906

# Directory where per-task git worktrees are created.
WORKTREES_DIR=/tmp/gridiron-worktrees

# Directory where GitHub repos cloned via the UI are stored.
REPOS_DIR=/tmp/gridiron-repos

# ------------------------------------------------------------
# PIPELINE BEHAVIOUR
# ------------------------------------------------------------
# full  = PM Agent → Architect Agent → Decomposer (LangGraph, Phase 3)
# simple = single Planner Agent (Phase 1 mode, no LangGraph)
PIPELINE_MODE=full

# Max self-correction retries before Coder marks task blocked.
MAX_RETRIES=3

# Token budget for context assembly (used by context_builder).
CONTEXT_TOKEN_BUDGET=8000

# Timeout (seconds) applied to every Anthropic SDK client construction.
LLM_CALL_TIMEOUT_SECONDS=300.0

# Override path to agent_models.json. Leave empty to use the built-in
# default at backend/app/fleet/agent_models.json.
AGENT_MODELS_PATH=

# Max tokens for Opus-tier agents (only relevant when an agent's model is
# upgraded to Opus via env var, per CLAUDE.md model tiering).
MAX_TOKENS_OPUS=8192

# Extended thinking budget (tokens) for Opus-tier agents.
THINKING_BUDGET_OPUS=2048

# ------------------------------------------------------------
# SECURITY BOUNDARIES (path/host allowlists)
# ------------------------------------------------------------
# Workspace paths must start with this prefix — path traversal guard for
# the Repo Console. Set to a real, restrictive parent directory in production.
ALLOWED_WORKSPACE_PARENT=/home

# Comma-separated allowed git remote hosts (clone/push targets).
GIT_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org

# ------------------------------------------------------------
# PHASE 5 — COST CONTROLLER
# ------------------------------------------------------------
# Epics with estimated cost (USD) above this require human approval before agents start.
COST_APPROVAL_THRESHOLD=1.0

# Model pricing per token (USD), per tier. Update when Anthropic pricing
# changes. INPUT/OUTPUT_TOKEN (no suffix) is the Sonnet-tier rate and also
# the fallback for any tier without its own dedicated var below.
COST_PER_INPUT_TOKEN=0.000003
COST_PER_OUTPUT_TOKEN=0.000015
COST_PER_INPUT_TOKEN_HAIKU=0.000001
COST_PER_OUTPUT_TOKEN_HAIKU=0.000005
COST_PER_INPUT_TOKEN_OPUS=0.000005
COST_PER_OUTPUT_TOKEN_OPUS=0.000025

# Baseline estimation coefficients (used when no historical data exists).
COST_TOKENS_PER_SUBTASK=4000
COST_OUTPUT_RATIO=0.3

# ------------------------------------------------------------
# GAP-CLOSURE DAY 35 (STAGE 2) — RESOURCE AWARENESS PRE-FLIGHT
# ------------------------------------------------------------
# Minimums checked before an epic/expensive operation may start. Deliberately
# conservative defaults so this doesn't block ordinary dev/CI machines.
RESOURCE_MIN_RAM_GB=1.0
RESOURCE_MIN_DISK_GB=2.0
RESOURCE_MIN_CPU_COUNT=1
RESOURCE_REQUIRED_PYTHON_VERSION=3.11
# Off by default — only operations that actually need Docker/GPU should opt in.
RESOURCE_REQUIRE_DOCKER=false
RESOURCE_REQUIRE_GPU=false
RESOURCE_CHECK_SUBPROCESS_TIMEOUT_SECONDS=5.0

# ------------------------------------------------------------
# GAP-CLOSURE DAYS 37-38 (STAGE 2) — PROJECT/REPO SIZE AWARENESS
# ------------------------------------------------------------
# Fallback coefficients — used only when no real agent_runs history exists yet.
SIZE_DISK_MULTIPLIER=3.0
SIZE_MEMORY_MB_PER_FILE=2.0
SIZE_INDEXING_SECONDS_PER_FILE=0.05
SIZE_EMBEDDING_SECONDS_PER_FILE=0.15
SIZE_PROCESSING_SECONDS_FALLBACK_PER_SUBTASK=180.0
SIZE_TEST_EXECUTION_SECONDS_FALLBACK=120.0

# ------------------------------------------------------------
# PHASE 5 — MANAGER AGENT
# ------------------------------------------------------------
# Max retries per subtask before it is counted as blocked.
MANAGER_MAX_SUBTASK_RETRIES=2
# Number of blocked subtasks that triggers epic.halted.
MANAGER_MAX_EPIC_FAILURES=2

# ------------------------------------------------------------
# PHASE 5 — DEVOPS AGENT (read-only bash allowlist)
# ------------------------------------------------------------
# Comma-separated command prefixes the DevOps agent may run.
# Only add safe, read-only commands.
DEVOPS_BASH_ALLOWLIST=git status,git log,git diff,df -h,du -sh,ls,pwd,cat,echo,free -h,uptime

# ------------------------------------------------------------
# PHASE 5 — RBAC
# ------------------------------------------------------------
# Set to false in local dev / tests to skip RBAC enforcement.
RBAC_ENABLED=true

# Allow the X-User-Role header to grant a role with zero verification when
# JWT auth is disabled. Insecure — for local/dev convenience only. Defaults
# off; a deployment that wants the old no-real-auth convenience must opt in
# explicitly (Audit 05 fix, SEC-05-014).
ALLOW_LEGACY_ROLE_HEADER=false

# ------------------------------------------------------------
# PHASE 6 — RESEARCH AGENT
# ------------------------------------------------------------
# Set to false to skip the Research Agent step before planning.
RESEARCH_ENABLED=true

# ------------------------------------------------------------
# PHASE 6 — ENGINEERING MEMORY (pgvector)
# ------------------------------------------------------------
# Set to false to disable task outcome embedding and memory queries.
MEMORY_ENABLED=true
# Number of similar past tasks injected into Architect Agent context.
MEMORY_TOP_K=3
# audit_v1.md 4.4 #1: candidate overfetch factor for two-stage HNSW retrieval
# (inner ORDER BY embedding <=> :vec LIMIT top_k * this uses the index; outer
# composite-score re-rank only touches that small candidate set).
MEMORY_CANDIDATE_OVERFETCH_FACTOR=10
# audit_v1.md 4.4 #3: bound on how many most-recent chat_messages rows
# load_history_from_db() restores for a session lost from in-memory state.
CHAT_HISTORY_RESTORE_LIMIT=200

# ------------------------------------------------------------
# PHASE 7 — CONCURRENCY CAPS
# ------------------------------------------------------------
# Max number of epics that can run simultaneously.
MAX_CONCURRENT_EPICS=10
# Max total agent runs across all epics at the same time.
MAX_CONCURRENT_AGENT_RUNS=20
# Max subtasks running simultaneously within a single epic.
MAX_CONCURRENT_SUBTASKS_PER_EPIC=5

# ------------------------------------------------------------
# PHASE 7 — EXECUTIVE AGENT
# ------------------------------------------------------------
# Max number of epics the Executive Agent may create from a single goal.
EXECUTIVE_MAX_EPICS_PER_GOAL=5

# ------------------------------------------------------------
# PHASE 7 — QUEUE BACKEND
# ------------------------------------------------------------
# asyncio (default, in-process) or rq (requires a running Redis + rq worker).
QUEUE_BACKEND=asyncio
# Blocker 8 (audit_v1.md 4.7 #2): max automatic RQ job retries before a job
# lands in RQ's own FailedJobRegistry. Only applies when QUEUE_BACKEND=rq.
QUEUE_JOB_RETRY_MAX=3
# How often the background loop sweeps RQ's FailedJobRegistry into
# structured failed_events rows. Only runs when QUEUE_BACKEND=rq.
QUEUE_FAILED_JOB_SWEEP_INTERVAL_SECONDS=300

# ------------------------------------------------------------
# GAP DAY 4 — REDIS (used by RQ queue and Redis Streams)
# ------------------------------------------------------------
# Redis connection URL. Only needed when QUEUE_BACKEND=rq or REDIS_STREAMS_ENABLED=true.
REDIS_URL=redis://localhost:6379/0

# Set true to publish events to Redis Streams (in addition to in-process bus).
REDIS_STREAMS_ENABLED=false

# Consumer group name for Redis Streams consumers.
REDIS_CONSUMER_GROUP=gridiron-consumers

# audit_v1.md 4.6 #2 (Phase K): how often the background loop drains/acks
# the Redis Streams event stream. Only runs when REDIS_STREAMS_ENABLED=true.
REDIS_STREAMS_DRAIN_INTERVAL_SECONDS=60
# Idle time (ms) before a pending Redis Streams entry is reclaimed via
# XAUTOCLAIM (a previous consumer likely crashed before acking it).
REDIS_STREAMS_STALE_PENDING_MS=60000

# ------------------------------------------------------------
# GAP DAY 4 — S3 ARTIFACT STORAGE
# ------------------------------------------------------------
# db (default, PostgreSQL) or s3 (AWS S3).
ARTIFACT_BACKEND=db

# S3 bucket name. Required when ARTIFACT_BACKEND=s3.
S3_BUCKET=

# AWS region for the S3 bucket.
S3_REGION=us-east-1

# Key prefix for artifact objects in the bucket.
S3_KEY_PREFIX=gridiron/artifacts/

# AWS credentials. Leave empty to use IAM role or environment credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------
# SERVER
# ------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Logging level for the FastAPI server (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Comma-separated CORS origins. Add your production frontend URL here.
# Example: https://app.gridiron.example.com,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------
# OBSERVABILITY (Sentry — optional, leave empty to disable)
# ------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Fraction of transactions sent to Sentry (0.0-1.0).
SENTRY_TRACES_SAMPLE_RATE=0.1

# ------------------------------------------------------------
# ALERTING (optional — webhook on task blocked/failed)
# ------------------------------------------------------------
# Payload: {source, event, task_id, detail, timestamp}
ALERT_WEBHOOK_URL=
ALERT_ON_BLOCKED=true

# ------------------------------------------------------------
# LOG RETENTION
# ------------------------------------------------------------
# Days to keep task_logs rows before automated cleanup. 0 disables cleanup.
LOG_RETENTION_DAYS=90
# audit_v1.md 4.1 #5: days to keep LangGraph checkpoint/checkpoint_blobs/
# checkpoint_writes rows (hard delete — replay/resume scaffolding, not
# audit history) before cleanup. 0 disables.
CHECKPOINT_RETENTION_DAYS=30

# ------------------------------------------------------------
# RELIABILITY TUNING
# ------------------------------------------------------------
# Max handler retry attempts in the in-process event bus.
EVENT_BUS_MAX_RETRIES=3

# Max Groq API call retries on transient RateLimitError.
GROQ_MAX_RETRIES=5

# audit_v1.md 4.2 #3: files larger than this (checked via os.stat() before
# ever reading bytes) are skipped from repo indexing entirely.
SCANNER_MAX_INDEXABLE_FILE_BYTES=2000000

# ------------------------------------------------------------
# LEADER ELECTION (horizontal scaling — audit_v1.md 4.8 #5)
# ------------------------------------------------------------
# Gates each singleton background loop behind a Postgres advisory lock so
# only one backend instance runs it under a multi-instance deployment.
# Set false only for a deliberately single-instance deployment.
LEADER_ELECTION_ENABLED=true
# How often a non-leader instance retries acquiring a loop's lock.
LEADER_ELECTION_RETRY_SECONDS=30

# ------------------------------------------------------------
# RATE LIMITING (slowapi)
# ------------------------------------------------------------
# Set false to disable API rate limiting in development.
RATE_LIMIT_ENABLED=true

# Default limit for all endpoints (N/second|minute|hour).
RATE_LIMIT_DEFAULT=200/minute

# Stricter limits for expensive endpoints.
RATE_LIMIT_TASKS=60/minute
RATE_LIMIT_AGENTS=30/minute

# Tightest limit — the unauthenticated login/setup endpoints (the only
# credential-checking routes in the API, and the natural brute-force target).
RATE_LIMIT_LOGIN=10/minute

# ------------------------------------------------------------
# JWT AUTHENTICATION
# ------------------------------------------------------------
# Generate with: openssl rand -hex 32
# REQUIRED in production when JWT_AUTH_ENABLED=true.
JWT_SECRET_KEY=

# JWT signing algorithm.
JWT_ALGORITHM=HS256

# Access token lifetime in minutes (default: 24 hours).
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Set true to enforce JWT Bearer tokens on all RBAC-protected endpoints.
# When false (default), the legacy X-User-Role header is accepted instead.
JWT_AUTH_ENABLED=false

# Password auto-seeded for the "admin" user on first startup.
# CHANGE THIS in production.
DEFAULT_ADMIN_PASSWORD=gridiron123

# ------------------------------------------------------------
# FLEET ENHANCEMENT DASHBOARD (Day 9 — 5 self-improvement agents)
# ------------------------------------------------------------
# Root of the Gridiron project itself. These 5 agents (unlike every other agent)
# target this codebase, not a user-connected repo. Defaults to cwd.
FLEET_SELF_REPO_PATH=.

# Hours between automatic SCAN-phase runs (background loop). 0 disables the loop.
FLEET_SCAN_INTERVAL_HOURS=4

# ------------------------------------------------------------
# FLEET OS BUDGET MANAGER (Day 10 — live spend/resource enforcement)
# ------------------------------------------------------------
# Max total tokens (in+out) a single agent run may consume before BudgetExceeded.
MAX_TOKENS_PER_AGENT_RUN=100000

# Max cumulative agent spend (USD) per calendar day before BudgetExceeded.
COST_BUDGET_DAILY_USD=25.0

# Max wall-clock seconds a single agent run may take before BudgetExceeded.
MAX_RUN_TIME_SECONDS=600

# Max resident memory (MB) a single agent run may use before BudgetExceeded.
MAX_MEMORY_MB=1024

# ------------------------------------------------------------
# FLEET OS BENCHMARK MANAGER (Day 10 — composite score + regression detection)
# ------------------------------------------------------------
# p50 latency (ms) considered "perfect" (score 1.0); 0 at 2x this value.
BENCHMARK_LATENCY_TARGET_MS=30000.0

# Composite benchmark_score weights — should sum to 1.0.
BENCHMARK_WEIGHT_LATENCY=0.15
BENCHMARK_WEIGHT_TOOL_ACCURACY=0.20
BENCHMARK_WEIGHT_VERIFICATION_COVERAGE=0.20
BENCHMARK_WEIGHT_RETRY_SUCCESS=0.15
BENCHMARK_WEIGHT_COMPILE_SUCCESS=0.15
BENCHMARK_WEIGHT_HALLUCINATION=0.15

# Fractional drop in benchmark_score vs. baseline that flags a regression.
BENCHMARK_REGRESSION_THRESHOLD=0.10

# Hours between automatic baseline-population sweeps (agents with real runs
# but no stored baseline yet). 0 disables. Without this, regression_detector's
# gate is a no-op for every agent since "no baseline" always means "no regression".
BENCHMARK_BASELINE_INTERVAL_HOURS=24

# Hours between checks for whether target_repo_path's local `main` HEAD has
# moved since changelog_agent/release_notes_agent last ran, auto-dispatching
# each when it has (gap-closure Day 52, answers.md Q41). 0 disables.
DOC_AGENT_AUTO_TRIGGER_INTERVAL_HOURS=6

# ------------------------------------------------------------
# FLEET OS VERSIONED MEMORY (Day 11 — merge-on-conflict lesson lifecycle)
# ------------------------------------------------------------
# Cosine similarity above which publishing a lesson on an existing topic
# triggers a merge (new version + LLM merge call) instead of a plain new version.
MEMORY_MERGE_SIMILARITY_THRESHOLD=0.85

# Days to keep SUPERSEDED/MERGED_INTO versioned_lessons rows before archiving. 0 disables.
LESSON_RETENTION_DAYS=180

# Days to keep memory_embeddings rows before the retention loop marks them
# archived=true. 0 disables. Separate from LOG_RETENTION_DAYS since
# engineering memory is longer-lived than raw execution logs.
MEMORY_EMBEDDINGS_RETENTION_DAYS=180

# ------------------------------------------------------------
# GIT PUSH WORKFLOW (Day 14 — branch/commit/PR creation)
# ------------------------------------------------------------
# GitHub personal access token for creating PRs via the REST API. No credential
# vault exists yet — prefer setting via the Settings UI (stored in the DB,
# POST /api/settings/github-token) over this env var. Never logged.
GITHUB_TOKEN=

# GitHub REST API base URL — override for GitHub Enterprise.
GITHUB_API_BASE_URL=https://api.github.com

# ------------------------------------------------------------
# CREDENTIAL VAULT (Day 17 — encrypted-at-rest credential storage)
# ------------------------------------------------------------
# Fernet key encrypting SystemSetting-backed credentials (Anthropic/OpenAI/
# GitHub keys, custom secrets) at rest. Strongly recommended in production —
# when unset, credentials are stored in plaintext (a startup warning is
# logged). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
