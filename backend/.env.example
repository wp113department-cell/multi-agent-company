# [PROD] When True (default), the sync create_pr_handler (used by make_chat_handlers()) always
# refuses to run `gh pr create` — there is no real per-call human-approval channel available to
# this handler tier. Set False only for a deployment that has explicitly decided its one-shot
# CREATE_PR_REQUIRE_APPROVAL=true

